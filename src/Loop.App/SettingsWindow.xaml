<Window x:Class="Loop.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loop settings"
        Icon="pack://application:,,,/Assets/loop.ico"
        Width="620" Height="760" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="#F7F7F9">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="12,8,12,10" />
            <Setter Property="BorderBrush" Value="#DADCE0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,2" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,16,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="76" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5F6368" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DADCE0" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <Button x:Name="ResetButton" Content="Reset to defaults" Click="OnReset" DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" Click="OnCancel" Margin="0,0,8,0" />
                    <Button x:Name="SaveButton" Content="Save" IsDefault="True" Click="OnSave" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Foreground="#B3261E" TextWrapping="Wrap"
                   Margin="16,8,16,0" Visibility="Collapsed" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14,16,4">
            <StackPanel>

                <GroupBox Header="Trigger">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Hold these modifiers together, then press a key below." />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="TriggerCtrl" Content="Ctrl" />
                            <CheckBox x:Name="TriggerWin" Content="Win" />
                            <CheckBox x:Name="TriggerAlt" Content="Alt" />
                            <CheckBox x:Name="TriggerShift" Content="Shift" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Mouse">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Open a radial menu at the cursor to snap the window under it. Keep holding, move toward a direction, and let go; or let go right away and click a direction. The middle maximizes, scrolling cycles sizes, and right-click or Esc cancels." />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Open the menu with" Style="{StaticResource Label}" />
                            <ComboBox x:Name="MouseTrigger" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3"
                                      HorizontalAlignment="Left" MinWidth="260" SelectionChanged="OnMouseTriggerChanged" />
                            <TextBlock Grid.Row="1" Text="Double-click speed (ms)" Style="{StaticResource Label}" />
                            <TextBox x:Name="MouseDoubleClickSpeed" Grid.Row="1" Grid.Column="1" Margin="0,3" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Hint}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Text="The second press must follow this quickly" />
                        </Grid>
                        <TextBlock x:Name="MouseTriggerNote" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="A single middle click still works, but reaches apps this much later, while Loop waits to see whether a second press follows." />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Behavior">
                    <StackPanel>
                        <RadioButton x:Name="ModeOnRelease" GroupName="Mode"
                                     Content="Preview while holding the trigger, move on release (Esc cancels)" />
                        <RadioButton x:Name="ModeInstant" GroupName="Mode" Content="Move instantly on each key press" />
                        <CheckBox x:Name="ShowPreview" Content="Show the preview" Margin="22,6,0,4"
                                  IsEnabled="{Binding IsChecked, ElementName=ModeOnRelease}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Cycle sizes" Style="{StaticResource Label}" />
                            <TextBox x:Name="CycleSizes" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3" />

                            <TextBlock Grid.Row="1" Text="Gap (px)" Style="{StaticResource Label}" />
                            <TextBox x:Name="Gap" Grid.Row="1" Grid.Column="1" Margin="0,3" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Hint}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Text="Space between tiled windows and screen edges" />

                            <TextBlock Grid.Row="2" Text="Chord window (ms)" Style="{StaticResource Label}" />
                            <TextBox x:Name="ChordGrace" Grid.Row="2" Grid.Column="1" Margin="0,3" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Hint}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Text="Arrows pressed this close together count as one chord" />

                            <TextBlock Grid.Row="3" Text="Preview color" Style="{StaticResource Label}" />
                            <TextBox x:Name="PreviewColor" Grid.Row="3" Grid.Column="1" Margin="0,3"
                                     TextChanged="OnColorChanged" />
                            <Border x:Name="ColorSwatch" Grid.Row="3" Grid.Column="2" Width="44" Height="22"
                                    CornerRadius="5" BorderThickness="2" Margin="10,0,0,0" HorizontalAlignment="Left" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="Cycle sizes are what pressing the same layout repeatedly steps through, e.g. 1/2, 1/3, 2/3." />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Animation">
                    <StackPanel>
                        <CheckBox x:Name="AnimateWindows" Content="Glide windows into place" />
                        <CheckBox x:Name="AnimatePreview" Content="Animate the preview (fade and glide)" />
                        <CheckBox x:Name="ShowIndicator" Content="Show a direction indicator at the cursor while the trigger is held" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Duration (ms)" Style="{StaticResource Label}" />
                            <TextBox x:Name="AnimationDuration" Grid.Column="1" Margin="0,3" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Text="0 turns animation off" />
                            <TextBlock Grid.Row="1" Text="Easing" Style="{StaticResource Label}" />
                            <ComboBox x:Name="AnimationEasing" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                      Margin="0,3" HorizontalAlignment="Left" MinWidth="180" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="Loop doesn't animate when Windows' Animation effects setting is off, for maximize, restore and minimize (Windows animates those), between displays with different scaling, or for apps that redraw too slowly to keep up." />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Keys">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Click a key to change it, then press the new key. Esc stops recording. Arrow combinations (corners, centering) follow the four direction keys." />
                        <ItemsControl x:Name="BindingList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="{Binding ButtonText}" Click="OnRecord"
                                                Tag="{Binding}" HorizontalContentAlignment="Center" />
                                        <Button Grid.Column="2" Content="Clear" Click="OnClearBinding" Tag="{Binding}"
                                                Margin="6,0,0,0" MinWidth="0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Excluded apps">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Loop never moves windows of these programs. Enter a process name such as notepad or notepad.exe." />
                        <ListBox x:Name="ExcludedList" Height="90" />
                        <DockPanel Margin="0,6,0,0">
                            <Button Content="Remove" Click="OnRemoveExcluded" DockPanel.Dock="Right" Margin="6,0,0,0" />
                            <Button Content="Add" Click="OnAddExcluded" DockPanel.Dock="Right" Margin="6,0,0,0" />
                            <TextBox x:Name="ExcludedInput" KeyDown="OnExcludedInputKeyDown" />
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Startup and permissions">
                    <StackPanel>
                        <CheckBox x:Name="LaunchAtStartup" Content="Start Loop when I sign in to Windows" />
                        <CheckBox x:Name="RunAsAdministrator" Content="Run as administrator" />
                        <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,0"
                                   Text="Windows keeps normal apps from moving windows of apps that run as administrator (and from seeing keys while one has focus). Turn this on to manage those too. Loop restarts and Windows asks for permission; at sign-in it starts through Task Scheduler, without asking." />
                        <TextBlock x:Name="ElevationState" Style="{StaticResource Hint}" Margin="22,4,0,0" FontWeight="SemiBold" />
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
